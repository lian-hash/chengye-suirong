{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "城野随行",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/packageDetail/packageDetail",
      "style": {
        "navigationBarTitleText": "套餐详情"
      }
    },
    {
      "path": "pages/siteSelect/siteSelect",
      "style": {
        "navigationBarTitleText": "选择场地"
      }
    },
    {
      "path": "pages/orderCreate/orderCreate",
      "style": {
        "navigationBarTitleText": "提交订单"
      }
    },
    {
      "path": "pages/orderPay/orderPay",
      "style": {
        "navigationBarTitleText": "订单支付"
      }
    },
    {
      "path": "pages/orderList/orderList",
      "style": {
        "navigationBarTitleText": "我的订单"
      }
    },
    {
      "path": "pages/orderDetail/orderDetail",
      "style": {
        "navigationBarTitleText": "订单详情"
      }
    },
    {
      "path": "pages/deliveryTrack/deliveryTrack",
      "style": {
        "navigationBarTitleText": "配送追踪"
      }
    },
    {
      "path": "pages/review/review",
      "style": {
        "navigationBarTitleText": "评价"
      }
    },
    {
      "path": "pages/feed/feed",
      "style": {
        "navigationBarTitleText": "营地晒单"
      }
    },
    {
      "path": "pages/coupons/coupons",
      "style": {
        "navigationBarTitleText": "券包"
      }
    },
    {
      "path": "pages/favorites/favorites",
      "style": {
        "navigationBarTitleText": "我的收藏"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTitleText": "城野随行",
    "navigationBarBackgroundColor": "#2E7D32",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F7F4"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#2E7D32",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home_active.png"
      },
      {
        "pagePath": "pages/orderList/orderList",
        "text": "订单",
        "iconPath": "static/tabbar/order.png",
        "selectedIconPath": "static/tabbar/order_active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine_active.png"
      }
    ]
  }
}
