<mxfile host="drawio" type="device">
  <diagram name="图3-3 订单创建算法流程图" id="cysx-fig33">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1600" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="开始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="40" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="接收下单请求&lt;br&gt;（用户ID+套餐ID+场地ID+使用日期+份数+是否批量）" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="140" width="450" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="读取套餐与场地信息（读 D2、D3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="250" width="380" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="套餐已上架&lt;br&gt;且场地可用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="345" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="校验使用日期（读 D2）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="485" width="380" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="日期在可预约周期内？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="580" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="校验场地剩余容量（读 D3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="720" width="380" height="55" as="geometry"/>
        </mxCell>
