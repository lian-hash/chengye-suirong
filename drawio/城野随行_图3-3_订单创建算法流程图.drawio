          <mxGeometry x="190" y="815" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="校验装备可用数量（读 D5）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="955" width="380" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="可用数量≥订购份数？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="1050" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="生成订单号&lt;br&gt;写订单表 D4（状态=待支付）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
